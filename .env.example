# Copy to .env and fill in. Never commit .env.

# --- Telegram -----------------------------------------------------------------
# Token from @BotFather.
TELEGRAM_BOT_TOKEN=
# Random string you also pass to setWebhook; Telegram echoes it back in the
# X-Telegram-Bot-Api-Secret-Token header. Generate with: openssl rand -hex 32
WEBHOOK_SECRET_TOKEN=

# --- GitHub OAuth App ---------------------------------------------------------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Must match the callback URL registered on the OAuth App.
GITHUB_CALLBACK_URL=http://localhost:5000/oauth/github/callback

# --- Postgres -----------------------------------------------------------------
POSTGRES_USER=commitune
POSTGRES_PASSWORD=change-me
POSTGRES_DB=commitune
# Consumed by the API container; `db` is the compose service name.
POSTGRES_CONNECTION_STRING=Host=db;Port=5432;Database=commitune;Username=commitune;Password=change-me

# --- Data Protection ----------------------------------------------------------
# Where the encryption keys persist. Backed by a volume in docker-compose.
DATA_PROTECTION_KEY_PATH=/keys
